rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ========================================================
    // PRIVATE HOST ONBOARDING PHOTOS
    //
    // hostOnboarding/{uid}/photos/{fileName}
    //
    // Host:
    //   May upload/read only their own onboarding photos.
    //
    // KIVO Admin:
    //   May privately review onboarding photos.
    //
    // Nothing here is public.
    // ========================================================

    match /hostOnboarding/{uid}/photos/{fileName} {

      allow read:
        if request.auth != null
        && (
          request.auth.uid == uid
          || (
            request.auth.token.email == "admin@kivocharge.com"
            && request.auth.token.email_verified == true
          )
        );

      allow write:
        if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }


    // Everything else remains private.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
